{
  "name": "frontyback-crm",
  "version": "1.0.0",
  "description": "CRM multi-cliente de FrontyBack: recibe consultas por formulario y WhatsApp (texto y audio), responde automaticamente, y las organiza en un tablero por cliente.",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "mongodb": "^7.5.0",
    "resend": "^6.25.0",
    "web-push": "^3.6.7"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
