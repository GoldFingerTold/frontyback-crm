# Copiá este archivo a .env y completá los valores antes de arrancar el servidor.

# Puerto donde corre el servidor
PORT=3010

# MongoDB Atlas (mismo patrón que los otros sitios - un cluster, una base para el CRM)
MONGODB_URI=

# Sesión del panel (una clave larga y random, distinta por entorno)
SESSION_SECRET=

# Resend (mismo servicio que ya usás para los avisos por email de los sitios)
RESEND_API_KEY=
RESEND_FROM_EMAIL="FrontyBack <no-reply@frontyback.com>"

# --- WhatsApp Business Cloud API (Meta) ---
# Token permanente de la app de Meta (System User token, no el temporal de 24hs)
WHATSAPP_TOKEN=
# El texto que vos elijas para el "Verify Token" al configurar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# ID de la app de Meta (Meta for Developers -> tu app -> Configuración básica)
WHATSAPP_APP_SECRET=

# --- Transcripción de audios (Whisper, OpenAI) ---
OPENAI_API_KEY=

# --- Voz para las respuestas por audio (ElevenLabs) ---
ELEVENLABS_API_KEY=
# ID de una voz femenina en español - se elige desde la cuenta de ElevenLabs
ELEVENLABS_VOICE_ID=

# --- Hotmart (suscripción de clientes internacionales, fuera de Argentina) ---
# Link de checkout de cada plan/frecuencia (Hugo los arma en su panel de Hotmart, uno por
# oferta) - server/routes/public.js los expone en GET /api/public/planes para la landing.
HOTMART_PLAN1_MENSUAL="link_generico"
HOTMART_PLAN1_ANUAL="link_generico"
HOTMART_PLAN2_MENSUAL="link_generico"
HOTMART_PLAN2_ANUAL="link_generico"
HOTMART_PLAN3_MENSUAL="link_generico"
HOTMART_PLAN3_ANUAL="link_generico"
HOTMART_PLAN4_MENSUAL="link_generico"
HOTMART_PLAN4_ANUAL="link_generico"
# El "Hottok" de la cuenta de Hotmart de Hugo (Herramientas -> Webhook -> pestaña de
# Autenticación) - server/services/hotmart.js lo usa para verificar que un webhook
# realmente venga de Hotmart.
HOTMART_WEBHOOK_SECRET="token_secreto_generico"
